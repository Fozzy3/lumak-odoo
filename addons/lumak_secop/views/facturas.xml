<odoo>
    <!-- La factura legal sale de la solución gratuita de la DIAN; en Odoo queda su CUFE y lo que debe llegar al banco -->
    <record id="account_move_form_lumak" model="ir.ui.view">
        <field name="name">account.move.form.lumak</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_bank_id']" position="after">
                <field name="lumak_cufe" invisible="move_type not in ('out_invoice', 'out_refund')" placeholder="Pega aquí el CUFE de la DIAN"/>
                <field name="lumak_estampillas" invisible="move_type != 'out_invoice'"/>
                <field name="lumak_neto_esperado" invisible="move_type != 'out_invoice'"
                       help="Total menos el 15 % del IVA que retiene el cliente y las estampillas. Si llega menos, revisar el pago."/>
            </xpath>
        </field>
    </record>

    <!-- Por cobrar: facturas de venta publicadas que falta pagar -->
    <record id="action_lumak_por_cobrar" model="ir.actions.act_window">
        <field name="name">Por cobrar</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('move_type', '=', 'out_invoice'), ('state', '=', 'posted'), ('payment_state', 'in', ('not_paid', 'partial'))]</field>
        <field name="context">{'default_move_type': 'out_invoice'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nada por cobrar</p>
            <p>Las facturas salen del contrato: marca su objetivo «Alcanzado» y crea la factura desde la orden de venta.</p>
        </field>
    </record>
    <menuitem id="menu_lumak_por_cobrar" name="Por cobrar" parent="menu_lumak_root" action="action_lumak_por_cobrar" sequence="5"/>
</odoo>
